# ─────────────────────────────────────────────────────────────────────────────
# RULE: anything starting with VITE_ is copied into the website's JavaScript and
# can be read by every visitor. Only PUBLIC values may use the VITE_ prefix.
# Never create VITE_SUPABASE_SERVICE_ROLE_KEY or VITE_EVOLUTION_API_KEY.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public (safe in the browser) ─────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Server-only secrets (set in Vercel → Settings → Environment Variables) ───
# Bypasses all database security. Server routes refuse to run without it.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# WhatsApp gateway (Evolution API, self-hosted)
EVOLUTION_API_URL=https://your-evolution-api-server.com
EVOLUTION_API_KEY=your_evolution_global_apikey_here

# Shared secret the gateway must send to /api/whatsapp/webhook.
# Register the webhook URL as:  https://<your-domain>/api/whatsapp/webhook?token=<this value>
# At least 16 characters. Without it, the webhook accepts nothing.
EVOLUTION_WEBHOOK_TOKEN=a_long_random_string

# Secret for outside automations that auto-save properties via
# POST /api/whatsapp/parse (sent as the x-api-key header). At least 16 characters.
INGEST_API_KEY=another_long_random_string
